# ---------------------------------------------------------------------------
# Rasova — environment template
# Copy to .env locally. On Railway, set these in the service Variables tab.
# NEVER commit real secrets to git.
# ---------------------------------------------------------------------------

APP_NAME=Rasova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production values (Railway):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Logging — use daily rotation in production (14-day retention built in)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# LOG_CHANNEL=daily
# LOG_LEVEL=error
# LOG_DAILY_DAYS=14

# Optional: Slack webhook for critical errors (see config/logging.php)
# LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rasova
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Product images — local disk for dev, R2 (S3-compatible) for production
# ---------------------------------------------------------------------------
# FILESYSTEM_DISK=r2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=rasova-images
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://images.yourdomain.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Razorpay — use TEST keys locally, LIVE keys in production
# Dashboard → Settings → API Keys / Webhooks
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Production webhook URL: https://yourdomain.com/webhooks/razorpay

# ---------------------------------------------------------------------------
# Mail — Gmail SMTP works for low volume; consider Resend/SES at scale
# Gmail limits: ~500/day (Workspace) or ~100/day (free)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Railway / reverse-proxy — trust forwarded headers for HTTPS detection
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=*
